{
  "name": "splitscope-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "SplitScope: explainable ML data leakage auditor (frontend)",
  "engines": {
    "node": ">=20.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b && tsc -p tsconfig.app.json --noEmit",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:headed": "npm run build && playwright test --headed"
  },
  "dependencies": {
    "@types/node": "^26.6.5",
    "@xyflow/react": "^12.12.1",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "9.21.0",
    "@playwright/test": "1.51.0",
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "@vitejs/plugin-react": "4.3.4",
    "eslint": "9.21.0",
    "eslint-plugin-react-hooks": "5.1.0",
    "eslint-plugin-react-refresh": "0.4.19",
    "globals": "16.1.0",
    "jsdom": "25.0.1",
    "typescript": "5.7.3",
    "typescript-eslint": "8.18.2",
    "vite": "6.0.7",
    "vitest": "2.1.8"
  }
}
